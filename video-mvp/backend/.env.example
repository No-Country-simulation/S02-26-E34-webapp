# backend/.env.example
# Copy this file to .env and update the values as needed

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=videodb

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# AWS S3 Configuration (uncomment and configure if using S3)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET_NAME=your_bucket_name
# AWS_DEFAULT_REGION=us-east-1

# Cloudflare R2 Configuration (uncomment and configure if using R2)
# CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret
# CLOUDFLARE_R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
# CLOUDFLARE_R2_BUCKET_NAME=your_r2_bucket_name

# Security
SECRET_KEY=dev-secret-key-change-in-production

# AI Models (update paths as needed)
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5
WHISPER_MODEL_SIZE=tiny
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-flash-latest

# Rate Limiting (Requests per Window in seconds)
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_UPLOAD_WINDOW=3600
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_API_REQUESTS=1000
RATE_LIMIT_API_WINDOW=60

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Server Configuration
HOST=0.0.0.0
PORT=8000